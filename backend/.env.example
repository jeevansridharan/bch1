# ── Supabase (use SERVICE ROLE key for backend — bypasses RLS) ──────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Oracle Signing Key ────────────────────────────────────────────────────────
# WIF-encoded private key for the Tally Oracle.
# The corresponding pubkey must match PLATFORM_ORACLE_PK_HEX in the frontend.
ORACLE_WIF=your_oracle_wif_here

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── CORS ──────────────────────────────────────────────────────────────────────
# The URL of the frontend that is allowed to call this backend.
# Local development: http://localhost:5173
# Production (Vercel):  https://your-app.vercel.app
# Production (Netlify): https://your-app.netlify.app
FRONTEND_ORIGIN=http://localhost:5173
